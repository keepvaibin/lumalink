// kit.item: things picked up, placed in stages by name or made by code, in containers, carried in an inventory.
// An item is defined once by a mod (define, or its kit/item/<id>.json) and is an object of the kit's class
// KitItem wherever it stands: made by code (spawn: std make) or placed in a stage under "<mod id>/<id>" (the
// kernel's run-time alias row; alias names are one space for every mod). A mod's data items are defined on its first
// frame, so its stages can place them. The object shows the item's model, hovers and
// turns as the game's power-ups do when `floats`, and is picked up by the player's touch: its sound and shine play,
// what it gives is given (kit.item give; Carry counts into the inventory), and it is gone, to come back three seconds
// later when `respawns`.
// Containers: Crystal: the item stands in one of the game's own crystals (the object CrystalCage made around it) and
// cannot be taken until the crystal is broken; Bubble: the item hangs in the air above its place and drifts, and is
// taken as any other (the game's bubbles pop on touch).
// The inventory is per save file (svc.save): each carried count under the mod and the item's id, and the order the
// ids were first carried in. A file's copy takes it along; an erased file forgets it.
// Everything belongs to the mod that defined it: when it stops, its items' objects are killed with the
// game's own kill, its definitions and alias rows go; its inventory stays on the file for when it is on again.

use ./player/form
use svc.save
use svc.mods

// What a pickup, a defeated enemy or a script gives the player. An open enum: cases are only
// ever added. Carry: n into the inventory under the item's id. Call: the mod's function with the player.
pub enum Gives { Form(f: form.FormId), Coins(n: u32), StarBits(n: u32), Lives(n: u32), Health(n: u32), Carry(n: u32),
                 Call(f: fn(MarioActor)) }
pub enum Container { None, Bubble, Crystal }

pub struct Item {
    id: text                                  // placeable as "<id>" in its mod's stages, "<mod id>/<id>" elsewhere
    look: model
    shine: effect? = none
    sound_get: sound? = none
    gives: Gives
    container: Container = Container.None
    floats: bool = true                       // hovers and turns, as the game's power-ups
    respawns: bool = false
}

// An item's handle: its number, 0 for none. Its functions are also module functions (`item.spawn(i, at)`).
pub struct ItemId {
    n: u32
    fn spawn(self, at: vec3) -> LiveActor? { return spawn(self, at) }
    fn give(self) { give_item(self) }
    fn carried(self) -> u32 { return carried(self) }
    fn use_one(self) -> bool { return use_one(self) }
}

// An item as its data file writes it: content by name (the mod's own), what it gives without code.
pub enum GivesData { Coins(n: u32), StarBits(n: u32), Lives(n: u32), Health(n: u32), Carry(n: u32), Form(id: text) }
struct ItemData { look: text, shine: text = "", sound_get: text = "", gives: GivesData, container: Container = Container.None,
                  floats: bool = true, respawns: bool = false }

let respawn_frames: u32 = 180
let pick_radius: f32 = 80.0
let bubble_height: f32 = 250.0

// The definitions: each item, the mod it is counted for, whether it still holds.
var defs: list<Item> = []
var def_owner: list<u64> = []
var def_live: list<bool> = []
// The objects standing in the stage: each one's item (its place in defs) and the object.
var obj_item: list<u32> = []
var obj_ref: list<ref<LiveActor>> = []
// The alias names made and the definition each makes (a stopped mod's place is taken again when it restarts).
var alias_names: list<text> = []
var alias_defs: list<u32> = []
// Items made in a crystal and their crystals, one pair a place, for cage_of.
var cage_item: list<ref<LiveActor>> = []
var cage_obj: list<ref<LiveActor>> = []
// The definition the object being made is for (make runs init at once).
var making: u32 = 0

// Gives `g` to the player now: coins and star bits counted as the game counts its own, a life each (99 at most, the
// game's most), health as the game's heart pickups give it, a form through kit.player.form, a mod's function with the
// player. Carry is counted by the item that gives it (give_item, a pickup); given bare it is nothing. Lives are given once
// the game's files are read; the rest only to a player in a stage (nothing otherwise).
pub fn give(g: Gives) {
    match g {
        Gives.Lives(n) => {
            // The game's files hold them: a stage need not be there, the files must have been read.
            if not holds("system") {
                return
            }
            // The game holds at most 99 lives (GameDataPlayerStatus cMaxPlayerLeft): past that a one-up adds
            // nothing, and a large n would hold the frame.
            var k = n
            if k > 99 {
                k = 99
            }
            for i in 0..k {
                MR::incPlayerLeft()
            }
        }
        Gives.Carry(n) => {}
        else => {
            // The rest is the player's in a stage: nothing is given while there is none.
            if holds("player") {
                give_player(g)
            }
        }
    }
}

fn give_player(g: Gives) {
    match g {
        Gives.Coins(n) => MR::incCoin(n as i32)
        Gives.StarBits(n) => MR::addStarPiece(n as i32)
        Gives.Health(n) => MR::incPlayerLife(n)
        Gives.Form(f) => form.set(f)
        Gives.Call(f) => {
            if let p = MR::getPlayerDemoActor() {
                if let m = as_class<MarioActor>(p) {
                    f(m)
                }
            }
        }
        else => {}
    }
}

// ---- the inventory --------------------------------------------------------------------------------------------------

// A save key is 1 to 64 of a-z 0-9 _ - . (svc.save): a mod's text in it goes as two 32-bit hashes (64 bits).
fn key_of(t: text) -> text {
    return "{hash32(t)}.{hash32("~{t}")}"
}

// The one form of every kit save key (kit.item, kit.progress, kit.shop, kit.talk): "<mod id>/kit.<module>.<kind>.<id>",
// a value a library keeps for another mod (svc.save: the owner's id, '/', a name of 1 to 64 of a-z 0-9 _ - .). The
// owner by its id (stable across starts and reloads), never by its caller() number (the kernel's pointer to the
// running mod, another at every start); the value's own id as hashes. A forgotten mod's "<id>/..." values go with it,
// in every file. none for a mod that is not running: nothing is read or written for it.
pub fn save_key(owner: u64, module: text, kind: text, id: text) -> text? {
    guard let info = mods.of_mod(owner) else {
        return none
    }
    return "{info.id}/kit.{module}.{kind}.{key_of(id)}"
}

// Whether `key` is a value of `owner`'s for this module and kind (a save_key of its): what a public setter checks
// before it writes a key a mod handed in.
pub fn owns_key(owner: u64, key: text, module: text, kind: text) -> bool {
    guard let info = mods.of_mod(owner) else {
        return false
    }
    return key.starts_with("{info.id}/kit.{module}.{kind}.")
}

// The kit's saves: one rule for every mod's kit value. LumaKit saves it itself, in its
// own part of the save file (a library's service calls name the library), under the owning mod's id (save_key),
// whether the owner has code or only data and wherever the kit was entered from.
pub fn kept(key: text) -> bytes? {
    return save.get(key)
}

// A kit value written. Not pub: a pub function is callable by every mod that uses the kit, and caller() inside a kit
// hook reached from an export is that export's caller, so no check by caller() can tell LumaKit's own writes from a
// mod's.
fn put(key: text, value: bytes) {
    save.set(key, value)
}

fn count_key(owner: u64, id: text) -> text? {
    return save_key(owner, "item", "count", id)
}

fn order_key(owner: u64) -> text? {
    return save_key(owner, "item", "order", "")
}

fn count_of(owner: u64, id: text) -> u32 {
    guard let key = count_key(owner, id) else {
        return 0
    }
    if let data = kept(key) {
        return json.decode<u32>(data) ?? 0
    }
    return 0
}

fn order_of(owner: u64) -> list<text> {
    guard let key = order_key(owner) else {
        return []
    }
    if let data = kept(key) {
        return json.decode<list<text>>(data) ?? []
    }
    return []
}

fn add_carried(owner: u64, id: text, n: u32) {
    guard let key = count_key(owner, id) else {
        return
    }
    let had = count_of(owner, id)
    put(key, json.encode(had + n).bytes())
    var order = order_of(owner)
    if not order.contains(id) {
        order.push(id)
        if let ok = order_key(owner) {
            put(ok, json.encode(order).bytes())
        }
    }
}

// ---- definitions ----------------------------------------------------------------------------------------------------

// A definition's place in the lists for a handle of the calling mod's; none for an empty handle, another mod's, or
// one whose mod stopped.
fn def_at(i: ItemId) -> int? {
    if i.n == 0 or i.n > def_live.len() as u32 {
        return none
    }
    let k = (i.n - 1) as int
    if not def_live[k] or def_owner[k] != caller() {
        return none
    }
    return k
}

// The item defined for the calling mod (a second of the same id replaces the first; objects of it already standing
// keep the look they were made with). Its alias row makes "<mod id>/<id>" placeable in any stage.
pub fn define(i: Item) -> ItemId {
    return define_for(caller(), i)
}

// An item of mod `owner` (a caller() number), as define.
fn define_for(owner: u64, i: Item) -> ItemId {
    for k in 0..defs.len() {
        if def_live[k] and def_owner[k] == owner and defs[k].id == i.id {
            defs[k] = i
            return ItemId { n: (k + 1) as u32 }
        }
    }
    // The run-time alias (std alias_class): "<mod id>/<id>" (alias names are one space for every
    // mod) makes a KitItem whose first argument is the definition, the others the placement's own. Defined from a
    // mod's call it is that mod's, gone with it; from the kit's frame (data items) it is the kit's, and a placement of
    // a stopped mod's item is not made (KitItem.init).
    guard let info = mods.of_mod(owner) else {
        defs.push(i)
        def_owner.push(owner)
        def_live.push(true)
        log "kit.item: an item \"{i.id}\" of a mod that is not running; not placeable"
        return ItemId { n: defs.len() as u32 }
    }
    let name = "{info.id}/{i.id}"
    // The name's place from before the mod stopped, off: taken again, so the kit's alias row (data items) that still
    // names it makes this definition.
    for j in 0..alias_names.len() {
        if alias_names[j] == name {
            let k = (alias_defs[j] - 1) as int
            if not def_live[k] {
                defs[k] = i
                def_owner[k] = owner
                def_live[k] = true
                alias_class(name, "KitItem", [alias_defs[j] as i32])
                return ItemId { n: alias_defs[j] }
            }
        }
    }
    defs.push(i)
    def_owner.push(owner)
    def_live.push(true)
    let n = defs.len() as u32
    if alias_class(name, "KitItem", [n as i32]) {
        alias_names.push(name)
        alias_defs.push(n)
    } else {
        log "kit.item: \"{name}\" is taken; the item is made by spawn only"
    }
    return ItemId { n: n }
}

// The crystal an item's object stands in (Container.Crystal), while it stands; none for another object, an item not
// in a crystal, or one already broken. A mod breaks it by code with the game's own kill.
// The module keeps each item's crystal beside it.
pub fn cage_of(a: LiveActor) -> LiveActor? {
    var i = cage_item.len()
    while i > 0 {
        i -= 1
        let it = cage_item[i].get()
        let c = cage_obj[i].get()
        if it == none or c == none {
            cage_item.remove(i)
            cage_obj.remove(i)
        } else if MR::isDead(c!) {
            cage_item.remove(i)
            cage_obj.remove(i)
        } else if same(it!, a) {
            return c
        }
    }
    return none
}

// ---- models by name (references 4) ----------------------------------------------------------------------------------

// The model a data file of mod `owner` names, as a `model "..."` literal compiles: "<id>:<path>" is mod <id>'s
// "Luma/<id>/<path>"; a bare name is the mod's own "Luma/<owner's id>/<name>" when it has that archive, else the
// game's. none for an empty name or one the game has no archive for (the log names it).
pub fn model_of(owner: u64, name: text) -> model? {
    if name == "" {
        return none
    }
    var path = name
    if let colon = name.find(":") {
        path = "Luma/{name.slice(0, colon)}/{name.slice(colon + 1, name.len())}"
    } else if not name.starts_with("Luma/") {
        if let info = mods.of_mod(owner) {
            let own = "Luma/{info.id}/{name}"
            if archive_of(own) {
                path = own
            }
        }
    }
    if not archive_of(path) {
        log "kit: model {name} is neither the mod's nor the game's; not used"
        return none
    }
    return model_named(path)
}

// Whether the game has model `m`'s archive, so a kit object with a missing model is refused by name where the game
// would stop ("<name> cannot be loaded", ResourceHolderManager).
pub fn has_model(m: model) -> bool {
    return archive_of(m.name())
}

// The game's own search for an object's archive (MR::makeObjectArchiveFileName): "<id>:<path>" as /Luma/<id>/<path>;
// else /ObjectData (the language's first), /MapPartsData, then the name as a path (the language's first).
fn archive_of(name: text) -> bool {
    if let colon = name.find(":") {
        return MR::isFileExist("/Luma/{name.slice(0, colon)}/{name.slice(colon + 1, name.len())}", false)
    }
    let in_data = MR::isFileExist("/ObjectData/{name}", true) or MR::isFileExist("/MapPartsData/{name}", false)
    return in_data or MR::isFileExist(name, true)
}

// What a data file's `gives` gives: a form by its id among the calling mod's; none for a form it does not have.
pub fn gives_of(d: GivesData) -> Gives? {
    return gives_of_for(caller(), d)
}

// The same for mod `owner`'s data (a caller() number).
fn gives_of_for(owner: u64, d: GivesData) -> Gives? {
    match d {
        GivesData.Coins(n) => return Gives.Coins(n)
        GivesData.StarBits(n) => return Gives.StarBits(n)
        GivesData.Lives(n) => return Gives.Lives(n)
        GivesData.Health(n) => return Gives.Health(n)
        GivesData.Carry(n) => return Gives.Carry(n)
        GivesData.Form(id) => {
            if let f = form.find_for(owner, id) {
                return Gives.Form(f)
            }
            return none
        }
    }
}

// The calling mod's item `id`: one it defined, else the one of its kit/item/<id>.json, defined now (data
// and code make the same thing; code finds a data item to give it callbacks). none when there is neither, the file
// does not read as an item, or it names content or a form the mod does not have.
pub fn find(id: text) -> ItemId? {
    let owner = caller()
    for k in 0..defs.len() {
        if def_live[k] and def_owner[k] == owner and defs[k].id == id {
            return ItemId { n: (k + 1) as u32 }
        }
    }
    return data_item(owner, id)
}

// Mod `owner`'s kit/item/<id>.json defined as its item; none when there is no such file or it does not read as an
// item.
fn data_item(owner: u64, id: text) -> ItemId? {
    guard let data = mods.kit_read(owner, "item", id) else {
        return none
    }
    guard let d = json.decode<ItemData>(data) else {
        return none
    }
    guard let look = model_of(owner, d.look) else {
        return none
    }
    guard let gives = gives_of_for(owner, d.gives) else {
        return none
    }
    var shine: effect? = none
    if d.shine != "" {
        shine = effect_named(d.shine)
    }
    var sound_get: sound? = none
    if d.sound_get != "" {
        sound_get = sound_named(d.sound_get)
    }
    return define_for(owner, Item { id: id, look: look, shine: shine, sound_get: sound_get, gives: gives,
                                    container: d.container, floats: d.floats, respawns: d.respawns })
}

// The mods whose kit/item files are defined: each running mod needing LumaKit, on the first frame it runs,
// so a stage loaded after it starts can place its data items ("<mod id>/<id>"); again after a restart.
var data_read: list<u64> = []

fn read_data() {
    for m in mods.needing() {
        if data_read.contains(m) {
            continue
        }
        data_read.push(m)
        for file in mods.kit_names(m, "item") ?? [] {
            if data_item(m, file) == none {
                log "kit.item: kit/item/{file}.json is not an item (a content name or form the mod does not have)"
            }
        }
    }
}

// ---- the object -----------------------------------------------------------------------------------------------------

// An item standing in the stage. Its first placement argument is its definition's number (the alias row's, or
// spawn's). Made by the game's plain model object's maker.
class KitItem : LiveActor made by LumaObj {
    var def: u32 = 0
    var home: vec3 = vec3(0.0, 0.0, 0.0)
    var age: u32 = 0
    var gone_for: u32 = 0
    var cage: ref<LiveActor>? = none
    var caged: bool = false

    override fn init(rIter: TableIter) {
        MR::initDefaultPos(self, rIter)
        var n: i32 = making as i32
        MR::getPlacementArg0NoInit(rIter, var n)
        if n <= 0 or n > defs.len() as i32 {
            // A name no mod defines any more: not made; the log names it.
            log "kit.item: an item of definition {n} is placed and no mod defines it; not made"
            self.makeActorDead()
            return
        }
        if not def_live[(n - 1) as int] {
            // An item whose mod stopped: not made; the log names it.
            log "kit.item: an item of definition {n} is placed and its mod is off; not made"
            self.makeActorDead()
            return
        }
        def = n as u32
        let d = defs[(def - 1) as int]
        if not has_model(d.look) {
            log "kit.item: item {d.id}'s model {d.look.name()} is not in the game's files; not made"
            self.makeActorDead()
            return
        }
        self.initModelManagerWithAnm(d.look.name(), none, false)
        MR::connectToSceneMapObjStrongLight(self)
        self.initHitSensor(1)
        MR::addHitSensorMapObj(self, "body", 4, pick_radius, vec3(0.0, pick_radius * 0.5, 0.0))
        self.initEffectKeeper(1, none)
        self.initSound(2, false)
        MR::initShadowVolumeSphere(self, pick_radius * 0.6)
        MR::onCalcGravity(self)
        home = self.mPosition
        match d.container {
            Container.None => {}
            Container.Bubble => {
                // Up in the air above its place, against its gravity.
                home = home + self.mGravity * (0.0 - bubble_height)
                self.mPosition = home
            }
            Container.Crystal => {
                // One of the game's own crystals around it: the item cannot be taken until it breaks.
                let made = make("CrystalCageS", MakePlace { at: self.mPosition }, 1)
                if let c = made.first() {
                    cage = ref(c)
                    caged = true
                    cage_item.push(ref(self))
                    cage_obj.push(ref(c))
                    MR::invalidateHitSensors(self)
                }
            }
        }
        obj_item.push(def)
        obj_ref.push(ref(self))
        self.makeActorAppeared()
    }

    // Each step of the object (the game's own movement first: its binder, its sensors, its nerve).
    override fn movement() {
        base.movement()
        age += 1
        if gone_for > 0 {
            // Taken and coming back: shown again when its time is up.
            gone_for -= 1
            if gone_for == 0 {
                MR::showModel(self)
                MR::validateHitSensors(self)
            }
            return
        }
        if caged {
            var broken = true
            if let c = cage {
                if let live = c.get() {
                    broken = MR::isDead(live)
                }
            }
            if broken {
                caged = false
                cage = none
                MR::validateHitSensors(self)
            }
            return
        }
        if def == 0 or def > defs.len() as u32 {
            return
        }
        let d = defs[(def - 1) as int]
        if d.floats or d.container == Container.Bubble {
            // The game's power-ups: a slow turn about the up axis and a bob of a few units.
            self.mRotation = vec3(self.mRotation.x, self.mRotation.y + 3.0, self.mRotation.z)
            let bob = sin((age as f32) * 0.07) * 12.0
            self.mPosition = home + self.mGravity * (0.0 - bob)
        }
        if d.container == Container.Bubble {
            // A slow drift round its place.
            let drift = vec3(cos((age as f32) * 0.011) * 40.0, 0.0, sin((age as f32) * 0.013) * 40.0)
            self.mPosition = self.mPosition + drift
        }
    }

    override fn attackSensor(pSender, pReceiver) {
        if gone_for > 0 or caged or def == 0 {
            return
        }
        guard let other = pReceiver else {
            return
        }
        if not MR::isSensorPlayer(other) {
            return
        }
        // Picked up: its sound and shine, what it gives, then gone (for three seconds when it respawns).
        let k = (def - 1) as int
        if not def_live[k] {
            self.kill()
            return
        }
        let d = defs[k]
        if let s = d.sound_get {
            `MR::startSound(const LiveActor *, const char *, s32, s32)`(self, s.name(), -1, -1)
        }
        if let e = d.shine {
            MR::emitEffect(self, e.name())
        }
        match d.gives {
            Gives.Carry(n) => add_carried(def_owner[k], d.id, n)
            else => give(d.gives)
        }
        if d.respawns {
            gone_for = respawn_frames
            MR::hideModel(self)
            MR::invalidateHitSensors(self)
        } else {
            self.kill()
        }
    }
}

// The item made at `at` in the stage playing now, for the calling mod: its object, none for a handle that is not
// the calling mod's or when the stage cannot make one.
pub fn spawn(i: ItemId, at: vec3) -> LiveActor? {
    guard let k = def_at(i) else {
        return none
    }
    making = i.n
    let made = make("KitItem", MakePlace { at: at, args: [i.n as i32, 0, 0, 0, 0, 0, 0, 0] }, 1)
    making = 0
    return made.first()
}

// What the item gives, given to the player now without an object (a shop's ware, a quest's reward); Carry counts
// into the inventory.
pub fn give_item(i: ItemId) {
    guard let k = def_at(i) else {
        return
    }
    match defs[k].gives {
        Gives.Carry(n) => add_carried(def_owner[k], defs[k].id, n)
        else => give(defs[k].gives)
    }
}

// How many of the item the player carries on this file.
pub fn carried(i: ItemId) -> u32 {
    guard let k = def_at(i) else {
        return 0
    }
    return count_of(def_owner[k], defs[k].id)
}

// One of the item used up: false when none is carried.
pub fn use_one(i: ItemId) -> bool {
    guard let k = def_at(i) else {
        return false
    }
    let had = count_of(def_owner[k], defs[k].id)
    if had == 0 {
        return false
    }
    guard let key = count_key(def_owner[k], defs[k].id) else {
        return false
    }
    put(key, json.encode(had - 1).bytes())
    return true
}

// The calling mod's inventory on this file: each carried item and its count, in the order first carried (items
// used up to 0 stay in their place; an id the mod no longer defines is left out).
pub fn carried_all() -> list<(ItemId, u32)> {
    let owner = caller()
    var all: list<(ItemId, u32)> = []
    for id in order_of(owner) {
        for k in 0..defs.len() {
            if def_live[k] and def_owner[k] == owner and defs[k].id == id {
                all.push((ItemId { n: (k + 1) as u32 }, count_of(owner, id)))
            }
        }
    }
    return all
}

on frame {
    read_data()
}

on mods.stopped(gone) {
    var r = data_read.len()
    while r > 0 {
        r -= 1
        if data_read[r] == gone {
            data_read.remove(r)
        }
    }
    // The stopped mod's items: their objects killed with the game's own kill, newest first; their alias rows
    // go with the mod (the kernel's); the definitions stay in their places, off, so other mods' numbers hold.
    var i = obj_ref.len()
    while i > 0 {
        i -= 1
        let k = (obj_item[i] - 1) as int
        if def_owner[k] == gone {
            // Killed while its stage lives; a stage that ended took it with it.
            if holds("stage") {
                if let a = obj_ref[i].get() {
                    a.kill()
                }
            }
            obj_ref.remove(i)
            obj_item.remove(i)
        }
    }
    for k in 0..defs.len() {
        if def_owner[k] == gone {
            def_live[k] = false
        }
    }
}
