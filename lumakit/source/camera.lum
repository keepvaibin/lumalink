// kit.camera: the main camera taken for a time, camera rigs for views (follow, eye, side, above), mirror, field of
// view, shake. A rig is a svc.draw.view Camera, so the same rig drives the main camera (take) or a mod's draw.view
// (view.rig).
// The main camera: the newest live control's camera through draw.view, never the game camera's own pose (the game's
// camera keeps working out its own from its own, so it is back at once when the last control ends). A rig on an actor
// goes to main_rig (LumaCore places it on each frame's poses, so it never lags the actor); a fixed rig, a free camera,
// a shake or a field of view over the game's camera go to main_eye. Either holds while the world is held (kit.cutscene's
// aim each frame of a hold). The newest control holds; ending it gives the one before.
// A rig on the game's player is on the player as he is each frame: after a death, an arrival or a scene change the game
// makes his actor again, and the rig goes on with the new one. A rig on the player's joint (eye) hides the player's body
// (his shadow stays) through player.set_drawn for as long as it is on top, the new actor included; the rig's near_z is
// the near plane while it holds.
// Every control, the mirror, the field of view and a shake are recorded under caller(); `on mods.stopped` takes a
// stopped mod's away.
// Mirror: the stick's x flipped (MR::getPlayerStickX), and the 3-D picture flipped by LumaKit's post program kit_mirror
// at draw.post's WORLD stage (the HUD stays readable).
// `mirror`'s and `look`'s parameter is `enabled` (`on` is a keyword). The handle's functions are also module functions (`end`,
// `alive`).
// The free camera turns with the stick and with the player's look (input.look_mode while it is on top: the mouse held by
// the window, the pointer stick, a gyro, a finger), so it can be flown with a mouse.
// look(c) turns a rig's view the same way: the eye stays where the rig puts it and the player turns the view about the
// actor's up (gravity's, on a planet's underside too), starting along the rig's own look. The game moves the player by
// the stick along the main camera's view, so an eye rig with look() is a first person that can be played.
// Cuts: the main camera's view jumps when another control comes on top or the game's pose shows again under a shake or
// a field of view; the kit says so through draw.view's main_cut, so nothing blends across the jump (the picture between
// two frames, the player's animation). Taking the main camera and giving it back are cuts already; a turn of the look
// never is one. cut() says one for a mod's own jump (a cutscene's new shot).

use svc.draw.view
use svc.draw.post
use svc.player
use svc.input

pub struct Control {
    n: u64
    fn end(self) { end(self) }
    fn alive(self) -> bool { return alive(self) }
}

let to_degrees: f32 = 57.29578
let to_radians: f32 = 0.017453292

// The controls in force, oldest first: their numbers, owners, rigs (none: a free camera) and free cameras' speeds.
var controls: list<u64> = []
var control_owners: list<u64> = []
var control_rigs: list<view.Camera?> = []
var control_speeds: list<f32> = []
// Each rig's actor kept as a handle (a view is never kept past its frame): the rig is made again with it each frame,
// and an empty handle (the actor gone) keeps the last eye. A rig on the game's player is on whichever actor is the
// player now (control_on_player), so a new scene's player takes it over.
var control_actors: list<ref<LiveActor>?> = []
var control_on_player: list<bool> = []
// Whether the player turns the control's view (look).
var control_looks: list<bool> = []
var next_control: u64 = 1
// The last eye the main camera was given (a rig whose actor died keeps it); whether draw.view's main_eye holds one.
var last_eye: view.Eye? = none
var main_held: bool = false
// The control whose camera the main camera shows (0: the game's pose under a shake or a field of view, or none).
var shown_control: u64 = 0
// The free camera: where it is and where it looks (yaw and pitch, degrees), set from the game's camera when it starts.
var free_eye: vec3 = vec3(0.0, 0.0, 0.0)
var free_yaw: f32 = 0.0
var free_pitch: f32 = 0.0
var free_started: bool = false
// Whether the kit holds the player's look (input.look_mode) now: a free camera or a looking control on top.
var free_looking: bool = false
// The looking control's view (world axes, unit) and the control it is for; none until its first frame.
var look_dir: vec3? = none
var look_control: u64 = 0
// The player actor whose body a first-person control hid (his shadow stays). The game makes a new actor for a new
// scene, drawn whole: keep_hidden() hides that one too.
var hidden_player: ref<MarioActor>? = none
// The field of view (degrees; below 0: the game's or the rig's) and who set it.
var fov_degrees: f32 = -1.0
var fov_owner: u64 = 0
// Mirror: on, and who turned it on; LumaKit's post program for the picture while it is on.
var mirrored: bool = false
var mirror_owner: u64 = 0
var mirror_program: post.Program? = none
// A shake: its strength (game units), frames left, frames in all, who started it; the camera's frames for its wave.
var shake_strength: f32 = 0.0
var shake_left: u32 = 0
var shake_frames: u32 = 0
var shake_owner: u64 = 0
var frame: u64 = 0

fn index_of(n: u64) -> int? {
    for i in 0..controls.len() {
        if controls[i] == n {
            return i
        }
    }
    return none
}

// A unit vector (side's parameter `normal` hides the standard name there).
fn unit(v: vec3) -> vec3 {
    return normal(v)
}

fn the_player() -> LiveActor? {
    if let p = MarioAccess::getPlayerActor() {
        return p
    }
    return none
}

// The player's body shown again, when a first-person control hid it.
fn show_player() {
    if let h = hidden_player {
        if let m = h.get() {
            player.set_drawn(m, player.DRAWN_ALL)
        }
    }
    hidden_player = none
}

// A rig of every field (a service struct has no defaults): what a kind does not read is zero.
fn rig_of(k: view.Rig, fov_y: f32, actor: LiveActor, offset: vec3, joint: text, near_z: f32) -> view.Camera {
    let zero = vec3(0.0, 0.0, 0.0)
    return view.Camera { rig: k, eye: zero, at: zero, up: zero, fov_y: fov_y, actor: actor, offset: offset, joint: joint,
                         near_z: near_z }
}

// The rig made again on the actor `a` (the stored rig's actor is a view of a frame gone).
fn rig_on(r: view.Camera, a: LiveActor) -> view.Camera {
    return view.Camera { rig: r.rig, eye: r.eye, at: r.at, up: r.up, fov_y: r.fov_y, actor: a, offset: r.offset,
                         joint: r.joint, near_z: r.near_z }
}

// The actor of control i's rig this frame: the game's player as he is now for a rig on the player; none when the actor
// is gone (or there is no player, during a load).
fn actor_of(i: int) -> LiveActor? {
    if control_on_player[i] {
        return the_player()
    }
    guard let h = control_actors[i] else { return none }
    return h.get()
}

// A rig on the player's joint: the player's body hidden while it holds.
fn first_person(i: int) -> bool {
    guard let r = control_rigs[i] else { return false }
    return r.rig == view.Rig.Joint and control_on_player[i]
}

// While a first-person control is on top: the player actor of now hidden, once per actor. The game draws a new actor
// whole (a death, an arrival, a scene change); an actor already hidden is left as it is, so a later set_drawn of any
// mod holds.
fn keep_hidden() {
    if controls.len() == 0 or not first_person(controls.len() - 1) {
        return
    }
    guard let m = MarioAccess::getPlayerActor() else { return }
    if let h = hidden_player {
        if let was = h.get() {
            if same(was, m) {
                return
            }
        }
    }
    player.set_drawn(m, player.DRAWN_SHADOW)
    hidden_player = ref(m)
}

// The control on top changed: the player's body hidden or shown to match it, and the main camera on it at once (or the
// game's again with none).
fn settle() {
    var wants_first = false
    if controls.len() > 0 {
        wants_first = first_person(controls.len() - 1)
    }
    if wants_first {
        keep_hidden()
    } else {
        show_player()
    }
    var free_on_top = false
    if controls.len() > 0 {
        let top = controls.len() - 1
        if let r = control_rigs[top] {
            free_on_top = control_looks[top] and r.rig != view.Rig.Fixed
        } else {
            free_on_top = true
        }
    }
    if free_on_top and not free_looking {
        input.look_mode(input.Pad.Main, 1, 1.0)
        free_looking = true
    }
    if free_looking and not free_on_top {
        input.look_mode(input.Pad.Main, 0, 1.0)
        free_looking = false
    }
    if controls.len() == 0 {
        last_eye = none
        free_started = false
        if main_held {
            view.main_eye(none)
            main_held = false
            shown_control = 0
        }
    } else if control_rigs[controls.len() - 1] != none and holds("stage") {
        // The rig on top now, at once (the world may be held; a free camera starts at the next pose). With no stage
        // there is no camera to place: the next stage's first pose places it.
        place(vec3(0.0, 0.0, 0.0))
    }
}

// The top control's camera as the main camera this frame, moved by `shaking`: an actor's rig through main_rig (on this
// frame's poses) while still, else its eye through main_eye. The rig's last eye is kept (its actor may die).
fn place(shaking: vec3) {
    let top = controls.len() - 1
    if let r = control_rigs[top] {
        if r.rig != view.Rig.Fixed and length(shaking) == 0.0 {
            if let a = actor_of(top) {
                let rig = with_fov(rig_on(r, a))
                if let e = view.eye_of(rig) {
                    last_eye = e
                    if control_looks[top] {
                        let turned = turn_look(controls[top], a, e)
                        last_eye = view.Eye { eye: e.eye, at: e.eye + turned * 100.0, up: up_of(a, e), fov_y: e.fov_y }
                        shown(controls[top])
                        view.main_rig(rig, view.Look { look: turned, up: up_of(a, e), ahead: 0.0 })
                        main_held = true
                        return
                    }
                }
                shown(controls[top])
                view.main_rig(rig, none)
                main_held = true
                return
            }
        }
    }
    if let e = given_eye() {
        last_eye = e
        shown(controls[top])
        show(view.Eye { eye: e.eye + shaking, at: e.at + shaking, up: e.up, fov_y: e.fov_y })
    }
}

// The main camera about to show control `n`'s camera (0: the game's pose): a cut when the kit holds it on another
// (taking it is a cut already, said by draw.view itself).
fn shown(n: u64) {
    if main_held and shown_control != n {
        view.main_cut()
    }
    shown_control = n
}

// The rig with fov()'s field of view, when one is set.
fn with_fov(r: view.Camera) -> view.Camera {
    if fov_degrees < 0.0 {
        return r
    }
    return view.Camera { rig: r.rig, eye: r.eye, at: r.at, up: r.up, fov_y: fov_degrees, actor: r.actor,
                         offset: r.offset, joint: r.joint, near_z: r.near_z }
}

// The main camera at `e` through draw.view (fov() over the eye's own), so it holds while the world is held.
fn show(e: view.Eye) {
    var fy = e.fov_y
    if fov_degrees >= 0.0 {
        fy = fov_degrees
    }
    view.main_eye(view.Eye { eye: e.eye, at: e.at, up: e.up, fov_y: fy })
    main_held = true
}

// The actor's up: against its gravity, else the rig's own up.
fn up_of(a: LiveActor, e: view.Eye) -> vec3 {
    let g = a.mGravity
    if length(g) > 0.5 {
        return normal(g * -1.0)
    }
    return normal(e.up)
}

// The looking control's view this frame: kept level with the actor's up as gravity turns, turned by the player's look
// (right turns right, up looks up), its height held within 85 degrees of level. It starts along the rig's look.
fn turn_look(n: u64, a: LiveActor, e: view.Eye) -> vec3 {
    let up = up_of(a, e)
    var dir = normal(e.at - e.eye)
    if look_control == n {
        if let d = look_dir {
            dir = d
        }
    }
    // Level and height against the up of now.
    var level = dir - up * dot(dir, up)
    if length(level) < 0.001 {
        level = normal(e.at - e.eye) - up * dot(normal(e.at - e.eye), up)
    }
    if length(level) < 0.001 {
        level = cross(up, vec3(1.0, 0.0, 0.0))
    }
    level = normal(level)
    var height = atan2(dot(dir, up), length(dir - up * dot(dir, up)))
    let turn = input.look(input.Pad.Main)
    if turn.on != 0 {
        // About the up: a positive angle turns toward the up's left (up x level), so right is the negative.
        let side = cross(up, level)
        let a_turn = -turn.yaw
        level = normal(level * cos(a_turn) + side * sin(a_turn))
        height = clamp(height + turn.pitch, -85.0 * to_radians, 85.0 * to_radians)
    }
    dir = normal(level * cos(height) + up * sin(height))
    look_dir = dir
    look_control = n
    return dir
}

fn add_control(rig: view.Camera?, speed: f32) -> Control {
    let n = next_control
    next_control += 1
    var held: ref<LiveActor>? = none
    var on_player = false
    if let r = rig {
        if r.rig != view.Rig.Fixed {
            held = ref(r.actor)
            if let p = the_player() {
                on_player = same(r.actor, p)
            }
        }
    }
    controls.push(n)
    control_owners.push(caller())
    control_rigs.push(rig)
    control_speeds.push(speed)
    control_actors.push(held)
    control_on_player.push(on_player)
    control_looks.push(false)
    if rig == none {
        free_started = false
    }
    settle()
    return Control { n: n }
}

fn remove_at(i: int) {
    controls.remove(i)
    control_owners.remove(i)
    control_rigs.remove(i)
    control_speeds.remove(i)
    control_actors.remove(i)
    control_on_player.remove(i)
    control_looks.remove(i)
}

// The main camera follows the rig until end(); the newest control holds.
pub fn take(rig: view.Camera) -> Control {
    return add_control(rig, 0.0)
}

// A free camera from where the game's camera is: the move stick moves it along its look (up and down) and turns it
// (left and right), buttons 1 and 2 raise and lower it; `speed` units a frame at a full stick.
pub fn free(speed: f32 = 40.0) -> Control {
    return add_control(none, speed)
}

// The control re-set as a fixed rig at `e` (kit.cutscene calls it each frame); the main camera is there at once when
// the control holds, the world held or not (settle).
pub fn aim(c: Control, e: view.Eye) {
    guard let i = index_of(c.n) else { return }
    var filler = the_player()
    if let r = control_rigs[i] {
        filler = r.actor
    }
    guard let a = filler else { return }  // a fixed rig reads no actor, but a service struct's field cannot be none
    control_rigs[i] = view.Camera { rig: view.Rig.Fixed, eye: e.eye, at: e.at, up: e.up, fov_y: e.fov_y, actor: a,
                                    offset: vec3(0.0, 0.0, 0.0), joint: "", near_z: 0.0 }
    control_actors[i] = none
    control_on_player[i] = false
    settle()
}

pub fn end(c: Control) {
    if let i = index_of(c.n) {
        remove_at(i)
        settle()
    }
}

// The player turns the control's view (`enabled`), or the rig's own look again (false): with the mouse held by the window, the
// pointer stick, a gyro or a finger (input.look_mode while the control is on top). A free camera turns with the look
// already; a fixed rig (aim) is not turned.
pub fn look(c: Control, enabled: bool = true) {
    guard let i = index_of(c.n) else { return }
    control_looks[i] = enabled
    if look_control == c.n {
        look_dir = none
    }
    settle()
}

// The main camera's next view is a cut: nothing blends into it, neither the picture between two frames nor the
// player's animation (a cutscene's new shot). Taking the main camera, ending a control and another control on top are
// cuts already; a turn of the look never is one. Nothing while no control or shake holds the main camera.
pub fn cut() {
    if main_held {
        view.main_cut()
    }
}

pub fn alive(c: Control) -> bool {
    return index_of(c.n) != none
}

// A camera `distance` behind the target and `height` above it, looking at it, turning with it.
pub fn follow(target: LiveActor, distance: f32, height: f32 = 300.0) -> view.Camera {
    return rig_of(view.Rig.Follow, 45.0, target, vec3(0.0, height, -distance), "", 0.0)
}

// First person: the eye at the actor's joint, looking along its front, the near plane `near`. On the game's player, his
// body is hidden (his shadow stays) while this rig is the main camera's, and the rig stays on the player through a death,
// an arrival or a scene change, with the new actor's body hidden too.
pub fn eye(of: LiveActor, joint: text = "Head", near: f32 = 5.0) -> view.Camera {
    return rig_of(view.Rig.Joint, 60.0, of, vec3(0.0, 0.0, 0.0), joint, near)
}

// A side camera for 2D sections: `distance` from the player along `normal` (world axes), looking at the player. none
// while there is no player (the boot, the title, a load): a rig's actor cannot be empty.
pub fn side(normal: vec3, distance: f32) -> view.Camera? {
    var n = normal
    if length(n) < 0.001 {
        n = vec3(0.0, 0.0, 1.0)
    }
    guard let p = the_player() else { return none }
    return rig_of(view.Rig.World, 45.0, p, unit(n) * distance, "", 0.0)
}

// Two rigs `eye_distance` apart across the rig's look (left, right), for a pair of views (VR). A fixed rig moves its eye
// and the point it looks at; a follow or world rig its offset (a follow rig's x is the actor's side). A joint rig's
// pair is the joint's one eye (draw.view has no side offset for a joint).
pub fn stereo(rig: view.Camera, eye_distance: f32) -> (view.Camera, view.Camera) {
    let half = eye_distance * 0.5
    if rig.rig == view.Rig.Fixed {
        let across = unit(cross(rig.at - rig.eye, rig.up)) * half
        let left = view.Camera { rig: rig.rig, eye: rig.eye - across, at: rig.at - across, up: rig.up, fov_y: rig.fov_y,
                                 actor: rig.actor, offset: rig.offset, joint: rig.joint, near_z: rig.near_z }
        let right = view.Camera { rig: rig.rig, eye: rig.eye + across, at: rig.at + across, up: rig.up, fov_y: rig.fov_y,
                                  actor: rig.actor, offset: rig.offset, joint: rig.joint, near_z: rig.near_z }
        return (left, right)
    }
    var side_axis = vec3(half, 0.0, 0.0)
    if rig.rig == view.Rig.World {
        // World axes: across the look from the offset toward the actor, about the world's up.
        let flat = vec3(rig.offset.x, 0.0, rig.offset.z)
        if length(flat) > 0.001 {
            side_axis = unit(cross(flat, vec3(0.0, 1.0, 0.0))) * half
        }
    }
    let left = rig_of(rig.rig, rig.fov_y, rig.actor, rig.offset - side_axis, rig.joint, rig.near_z)
    let right = rig_of(rig.rig, rig.fov_y, rig.actor, rig.offset + side_axis, rig.joint, rig.near_z)
    return (left, right)
}

// The picture and the stick's x flipped, or not.
pub fn mirror(enabled: bool) {
    mirrored = enabled
    mirror_owner = caller()
    set_mirror_picture(enabled)
}

// LumaKit's program in its WORLD slot while the mirror is on; freed (the slot empty) when it goes off.
fn set_mirror_picture(enabled: bool) {
    if enabled {
        if mirror_program == none {
            mirror_program = post.program("kit_mirror")
        }
        if let p = mirror_program {
            post.set(post.Stage.World, p)
        }
    } else if let p = mirror_program {
        post.program_free(p)
        mirror_program = none
    }
}

// The main camera's vertical field of view in degrees (1 to 179); none: the game's own (or a control's rig's).
pub fn fov(degrees: f32?) {
    if let d = degrees {
        fov_degrees = clamp(d, 1.5, 178.5)
        fov_owner = caller()
    } else {
        fov_degrees = -1.0
    }
}

// The main camera shaken `strength` game units, fading out over `frames`.
pub fn shake(strength: f32, frames: u32) {
    shake_strength = strength
    shake_left = frames
    shake_frames = frames
    shake_owner = caller()
}

// Where the main camera is this frame.
pub fn now() -> view.Eye {
    var fy: f32 = 45.0
    if let d = MR::getCameraDirector() {
        if let man = d.getCurrentCameraMan() {
            fy = CameraLocalUtil::getFovy(man)
        }
    }
    return view.Eye { eye: MR::getCamPos(), at: MR::getCameraWatchPos(), up: MR::getCamYdir(), fov_y: fy }
}

// The free camera's eye this frame, moved by the stick.
fn free_step(speed: f32) -> view.Eye {
    if not free_looking {
        input.look_mode(input.Pad.Main, 1, 1.0)
        free_looking = true
    }
    if not free_started {
        let e = MR::getCamPos()
        let look = MR::getCameraWatchPos() - e
        free_eye = e
        free_yaw = atan2(look.x, look.z) * to_degrees
        free_pitch = atan2(look.y, length(vec3(look.x, 0.0, look.z))) * to_degrees
        free_started = true
    }
    let across = MR::getMoveStickX(0)
    let ahead = MR::getMoveStickY(0)
    if abs(across) > 0.1 {
        free_yaw -= across * 2.5  // degrees a game frame at a full stick
    }
    // The player's look: right turns right, up looks up (radians this frame).
    let turn = input.look(input.Pad.Main)
    if turn.on != 0 {
        free_yaw -= turn.yaw * to_degrees
        free_pitch = clamp(free_pitch + turn.pitch * to_degrees, -85.0, 85.0)
    }
    let yaw = free_yaw * to_radians
    let pitch = free_pitch * to_radians
    let front = vec3(sin(yaw) * cos(pitch), sin(pitch), cos(yaw) * cos(pitch))
    if abs(ahead) > 0.1 {
        free_eye = free_eye + front * (ahead * speed)
    }
    if MR::testCorePadButton1(0) {
        free_eye = free_eye + vec3(0.0, speed, 0.0)
    }
    if MR::testCorePadButton2(0) {
        free_eye = free_eye - vec3(0.0, speed, 0.0)
    }
    return view.Eye { eye: free_eye, at: free_eye + front * 100.0, up: vec3(0.0, 1.0, 0.0), fov_y: 45.0 }
}

// The shake's offset this frame (a fading wave on three axes), zero with none.
fn shake_now() -> vec3 {
    if shake_left == 0 or shake_frames == 0 {
        return vec3(0.0, 0.0, 0.0)
    }
    let t = frame as f32
    let s = shake_strength * (shake_left as f32 / shake_frames as f32)
    return vec3(sin(t * 1.7) * s, cos(t * 2.3) * s, sin(t * 3.1) * s)
}

// The top control's eye this frame; none: no control (or a rig whose actor is gone before it ever gave one).
fn given_eye() -> view.Eye? {
    if controls.len() == 0 {
        return none
    }
    let top = controls.len() - 1
    guard let r = control_rigs[top] else { return free_step(control_speeds[top]) }
    if r.rig == view.Rig.Fixed {
        return view.eye_of(r) ?? last_eye
    }
    guard let a = actor_of(top) else { return last_eye }
    guard let e = view.eye_of(rig_on(r, a)) else { return last_eye }
    if control_looks[top] and look_control == controls[top] {
        if let d = look_dir {
            return view.Eye { eye: e.eye, at: e.eye + d * 100.0, up: up_of(a, e), fov_y: e.fov_y }
        }
    }
    return e
}

// After the game worked out its own pose (once a frame): the top control's camera as the main camera, the shake on
// whichever shows. The game's pose is only read (with no control, a shake or a field of view goes on it), never written,
// so the game's camera works on from its own.
hook after CameraDirector::calcPose() {
    frame += 1
    let shaking = shake_now()
    if shake_left > 0 {
        shake_left -= 1
    }
    // While a stage is made or taken down the director poses with no stage around it: nothing is placed.
    if not holds("stage") {
        return
    }
    if controls.len() > 0 {
        keep_hidden()
        place(shaking)
        return
    }
    if length(shaking) == 0.0 and fov_degrees < 0.0 {
        if main_held {
            view.main_eye(none)
            main_held = false
            shown_control = 0
        }
        return
    }
    guard let pose = self.mPoseParam1 else { return }
    var fy: f32 = 45.0
    if let man = self.getCurrentCameraMan() {
        fy = CameraLocalUtil::getFovy(man)
    }
    shown(0)
    show(view.Eye { eye: pose.mPos + shaking, at: pose.mWatchPos + shaking, up: pose.mUpVec, fov_y: fy })
}

// Mirror: the stick's x as the picture shows it.
hook after MR::getPlayerStickX() -> x {
    if mirrored {
        result = -x
    }
}

// A mod that took the camera was taken out: its controls end (newest first), its mirror, field of view and
// shake are undone; the others' stay.
on mods.stopped(gone) {
    var i = controls.len()
    while i > 0 {
        i -= 1
        if control_owners[i] == gone {
            remove_at(i)
        }
    }
    settle()
    if mirrored and mirror_owner == gone {
        mirrored = false
        set_mirror_picture(false)
    }
    if fov_degrees >= 0.0 and fov_owner == gone {
        fov_degrees = -1.0
    }
    if shake_left > 0 and shake_owner == gone {
        shake_left = 0
    }
}
