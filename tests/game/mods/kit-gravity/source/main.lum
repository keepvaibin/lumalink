// kit.gravity conformance (lumakit-modules.md row 9; lumakit.md 2.8). Facts:
// parallel_flip_end  the player's gravity overridden to point up: the player's gravity is up; ended: the game's again
// by_frames          an override for 30 frames: alive at 10, ended by 40, the game's gravity again
// shape_priority     a shape of this mod ("KitTestPull", pulling along +x, priority 100, range 3000) placed by the mod's
//                    layer 8000 along z from the start: gravity.at there is the shape's (+x), above the planet's own
// two_mods           kit-gravity-b overrides after this mod (down along z): its field holds; when it ends, this mod's
use kit.gravity

fn player_gravity() -> vec3 {
    guard let g = MR::getPlayerGravity() else { return vec3(0.0, 0.0, 0.0) }
    return g
}

// Where the mod's layer places KitTestPull (planetobjinfo.json).
fn shape_point() -> vec3 {
    return vec3(-1264.6, -13081.3, -7332.0)
}

// The game's gravity where the player is now (its gravities and the mods' shapes, no override).
fn game_here() -> vec3 {
    return gravity.at(MR::getPlayerPos() ?? vec3(0.0, 0.0, 0.0))
}

fn pull_x(at: vec3) -> vec3? {
    return vec3(1.0, 0.0, 0.0)
}

on start {
    gravity.define_shape(gravity.Shape { name: "KitTestPull", vector: pull_x, range: 3000.0, priority: 100 })
}

task run() {
    wait 60 frames

    // parallel_flip_end
    let o = gravity.override_player(gravity.Field.Parallel(direction: vec3(0.0, 1.0, 0.0)))
    wait 10 frames
    log fact "flip_gravity" player_gravity()
    gravity.end_override(o)
    wait 10 frames
    log fact "flip_back" length(player_gravity() - game_here())

    // by_frames
    let at = (MR::getPlayerPos() ?? vec3(0.0, 0.0, 0.0)) + vec3(0.0, 5000.0, 0.0)
    let t = gravity.override_player(gravity.Field.Point(at: at), 30)
    wait 10 frames
    log fact "frames_alive_10" gravity.override_alive(t)
    wait 30 frames
    log fact "frames_alive_40" gravity.override_alive(t)
    log fact "frames_back" length(player_gravity() - game_here())

    // shape_priority
    log fact "shape_at" gravity.at(shape_point())

    // two_mods: this mod's field along -z; kit-gravity-b's along +z from 20 frames later for 30 frames.
    let mine = gravity.override_player(gravity.Field.Parallel(direction: vec3(0.0, 0.0, -1.0)))
    log fact "two_start" true
    wait 35 frames
    log fact "two_b_holds" player_gravity()
    wait 30 frames
    log fact "two_mine_back" player_gravity()
    gravity.end_override(mine)
    log fact "done" true
}

on stage "EggStarGalaxy" {
    start run()
}

on stop {
    log "kit-gravity: taken out"
}
