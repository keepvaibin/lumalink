{
  "harness": 1,
  "name": "k3-refs",
  "about": "LumaScript handles in a mod built by lumalink build: ref(view) of the player, two handles to one object equal, get() giving the object while it lives; after a stage change destroys the player, the held handle's get() is none, the handle stays a value, and a handle to the new player differs",
  "proves": [
    "script.build",
    "kernel.hook.after"
  ],
  "mods": [
    "../../mods/k3-refs"
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "steps": [
    {
      "at": 30,
      "call": "MR::zeroVelocity",
      "signature": "void(LiveActor *)",
      "args": [
        "player"
      ]
    },
    {
      "at": 40,
      "stage": {
        "name": "EggStarGalaxy",
        "scenario": 1
      }
    },
    {
      "at": 3000,
      "call": "MR::zeroVelocity",
      "signature": "void(LiveActor *)",
      "args": [
        "player"
      ]
    },
    {
      "at": 3010,
      "end": true
    }
  ],
  "expect": [
    {
      "fact": "mod.k3-refs.made",
      "is": [
        true,
        true,
        true
      ]
    },
    {
      "fact": "mod.k3-refs.after",
      "is": [
        true,
        true,
        true
      ]
    },
    {
      "fact": "stage.ready",
      "exists": true
    }
  ]
}
