{
  "harness": 1,
  "name": "k3-containers",
  "about": "LumaScript containers in a mod built by lumalink build: list, map and set with copy on write (a copy taken before a write keeps what it had); push, insert, remove, pop, get, first, last, contains, sort, len, keys, values; xs[i] and m[k] read and written; for over a list, a set and a map in key order; a list of text owning its blocks; containers in a struct, a list and a map; a for that grows the list it walks; a write into a container whose value keeps a copy of that container (the copy unchanged); parts read in the order written; closures written in the call (filter, map, any stopping at the first true, all, sum, sort_by descending and stable) inlined; sort on 1000 elements; sort_by of a list inside a list; text split and chars; bytes: text.bytes(), [i] read and written, push, write_u16 big end first, read_u16 little, write_f32/read_f32, read_u64 of the bits, slice, == and copy on write",
  "proves": [
    "script.build",
    "kernel.hook.after"
  ],
  "mods": [
    "../../mods/k3-containers"
  ],
  "stage": {
    "name": "EggStarGalaxy",
    "scenario": 1
  },
  "steps": [
    {
      "at": 30,
      "call": "MR::zeroVelocity",
      "signature": "void(LiveActor *)",
      "args": [
        "player"
      ]
    },
    {
      "at": 40,
      "end": true
    }
  ],
