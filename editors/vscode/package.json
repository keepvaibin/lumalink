{
 "name": "lumascript",
 "displayName": "LumaScript",
 "description": "%description%",
 "version": "1.0.0",
 "publisher": "keepvaibin",
 "license": "MIT",
 "engines": {
  "vscode": "^1.75.0"
 },
 "categories": [
  "Programming Languages",
  "Linters",
  "Formatters",
  "Snippets"
 ],
 "main": "./extension.js",
 "l10n": "./l10n",
 "activationEvents": [
  "onLanguage:lumascript",
  "workspaceContains:**/luma.json"
 ],
 "contributes": {
  "configuration": {
   "title": "LumaScript",
   "properties": {
    "lumascript.lumalink": {
     "type": "string",
     "default": "lumalink",
     "markdownDescription": "%setting.lumalink%"
    },
    "lumascript.names": {
     "type": "string",
     "default": "",
     "markdownDescription": "%setting.names%"
    },
    "lumascript.sdk": {
     "type": "string",
     "default": "",
     "markdownDescription": "%setting.sdk%"
    }
   }
  },
  "commands": [
   {
    "command": "lumascript.restart",
    "title": "%command.restart%"
   }
  ],
  "languages": [
   {
    "id": "lumascript",
    "aliases": [
     "LumaScript",
     "lumascript"
    ],
    "extensions": [
     ".lum"
    ],
    "configuration": "./language-configuration.json"
   }
  ],
  "grammars": [
   {
    "language": "lumascript",
    "scopeName": "source.lumascript",
    "path": "./syntaxes/lumascript.tmLanguage.json"
   }
  ],
  "snippets": [
   {
    "language": "lumascript",
    "path": "./snippets/lumascript.json"
   }
  ],
  "configurationDefaults": {
   "[lumascript]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
   }
  }
 }
}
